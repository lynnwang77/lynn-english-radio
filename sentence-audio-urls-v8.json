    },
    {
      "track": "Balance Sheet · Core Terms",
      "index": 11,
      "text": "Shareholders' Equity. The owners' residual interest in the company.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/422601fe-cb84-4af9-88ed-6b54fe75741b.mp3"
    },
    {
      "track": "Balance Sheet · Core Terms",
      "index": 12,
      "text": "Retained Earnings. Cumulative profits kept in the business over time.",
