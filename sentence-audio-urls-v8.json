    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 2,
      "text": "Cost of Goods Sold. Direct costs tied to what the company sells.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/10f3263a-3b50-4713-a277-aba92faff7f0.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 3,
      "text": "Gross Profit. Revenue minus cost of goods sold.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/8d286c72-d1d7-4d74-9348-4640bd6894a1.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 4,
      "text": "Operating Expenses. Costs of running the business.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/812628e6-bc6c-4d9d-bd1f-599ffd1c8b97.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 5,
      "text": "Payroll Expense. Wages, salaries, and related payroll costs.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/61cfa668-ee0b-484f-9875-a52773ad57e8.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 6,
      "text": "Advertising Expense. Money spent to attract customers.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a9c46558-6120-46cb-9166-8c23704c9787.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 7,
      "text": "Rent Expense. Cost of renting business space.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/2c69c15f-9bdf-4082-95db-1547026dfaa2.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 8,
      "text": "Depreciation Expense. The periodic cost of long-term assets.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d59ae243-9291-495c-bb9c-cedc7c5a0251.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 9,
      "text": "Operating Income. Profit from core business operations.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/8c47967d-2042-48dd-90ae-e01c60b56ae1.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 10,
      "text": "Interest Expense. The cost of borrowing money.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/89e049db-8799-4439-bdcf-751166c44f26.mp3"
    },
    {
      "track": "Profit & Loss · Core Terms",
      "index": 11,
      "text": "Net Income. Final profit after all income and expenses.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/b86f79e3-77ef-4101-bc91-40b9486ce8fd.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 1,
      "text": "Cash Flow from Operating Activities. Cash generated or used by normal operations.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/01745e8a-aea9-4c4e-97b6-be41c4092af7.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 2,
      "text": "Cash Flow from Investing Activities. Cash used for or received from long-term investments and assets.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/dd4a764e-dde5-4606-a8a5-2e5d5185440f.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 3,
      "text": "Cash Flow from Financing Activities. Cash from borrowing, repaying debt, or owner financing.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0f70a79a-be30-4578-9997-335937f4a5d7.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 4,
      "text": "Depreciation and Amortization. Non-cash expenses added back in operating cash flow.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/101fe9f7-3958-4a57-bbc7-737d5524ac29.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 5,
      "text": "Changes in Working Capital. Cash effects from changes in current assets and liabilities.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/1dbda2c7-b541-4a56-88e7-dd8b07b9827a.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 6,
      "text": "Capital Expenditures. Cash spent to buy long-term assets.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a6da5ebd-4ac9-4da0-a1ea-c6acabe4e7a0.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 7,
      "text": "Net Increase or Decrease in Cash. The total change in cash during the period.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/546eab0e-b879-4b81-b8e0-d1fa6d759c31.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 8,
      "text": "Beginning Cash Balance. Cash available at the start of the period.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/68784024-f281-4a30-b1a7-11ec5ebe78ab.mp3"
    },
    {
      "track": "Cash Flow · Core Terms",
      "index": 9,
      "text": "Ending Cash Balance. Cash available at the end of the period.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/b0d7b3e4-a16f-4047-8f3b-8805ffe33d5b.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 1,
      "text": "I'd like to open a new business bank account.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/ee5a5041-89d4-43b7-a7ce-81b5a608b40c.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 2,
      "text": "Should this account be separate from our other accounts?",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/716972dc-3cfc-4cc0-9059-9dc8b8b9901b.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 3,
      "text": "Can these accounts be linked together?",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/8c399eb0-e062-486d-9be4-72930803760b.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 4,
      "text": "Who will have access to this account?",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/256a48fd-0fe0-43fb-87fe-546c0d14089f.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 5,
      "text": "Does he need to be here in person to sign?",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/18c50e96-43ba-46b4-995f-969c8524db04.mp3"
    },
    {
      "track": "Bank Transfer",
      "index": 1,
      "text": "This is a transfer between two bank accounts.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/17954393-8c2d-45e5-8e8a-1b3f372dd09d.mp3"
    },
    {
      "track": "Bank Transfer",
      "index": 2,
      "text": "It should not be recorded as an expense.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0e094765-3215-491a-967d-40eead1dc982.mp3"
    },
    {
      "track": "Bank Transfer",
      "index": 3,
      "text": "I want to make sure the money has actually arrived.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/af437033-6ad8-4d90-82f2-872eb4c1841e.mp3"
    },
    {
      "track": "Bank Transfer",
      "index": 4,
      "text": "The transaction is still showing as pending.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a5bdfb6b-52da-461c-8c0b-0db7b386dbaa.mp3"
    },
    {
      "track": "Bank Transfer",
      "index": 5,
      "text": "We should avoid recording the same transaction twice.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/f53033e7-73c4-4fe6-87be-6ec5014b369b.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 6,
      "text": "He said he would be here at four.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/39a9b3de-d47c-48cd-9bf2-5e186e87132d.mp3"
    },
    {
      "track": "Bank Account Opening",
      "index": 7,
      "text": "I don't think I need to wait for him.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/667a905e-a206-4a7e-a08f-94ce75455651.mp3"
    },
    {
      "track": "Ramp Payment",
      "index": 1,
      "text": "The payment has been initiated, but it has not settled yet.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a253c808-8217-4e91-85ed-5dad1b649a44.mp3"
    },
    {
      "track": "Ramp Payment",
      "index": 2,
      "text": "The available balance is different from the forecasted balance.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/20af5d5e-66e0-4bcf-bc92-b95e7c35ce96.mp3"
    },
    {
      "track": "Ramp Payment",
      "index": 3,
      "text": "I need to know whether this payment is still in flight.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/a8c27a22-3e2c-4629-a0dc-01a6f5a807ab.mp3"
    },
    {
      "track": "Ramp Payment",
      "index": 4,
      "text": "Please check the payment status before making another transfer.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/c257fc28-768c-465c-af72-0fd622a0b374.mp3"
    },
    {
      "track": "Ramp Payment",
      "index": 5,
      "text": "I want the cash position to be clear before we move more money.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/f3323bba-69bf-495e-9487-572c3ad0cb64.mp3"
    },
    {
      "track": "QBO Match",
      "index": 1,
      "text": "This transaction already exists in QuickBooks.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/715a39ae-edc7-43c0-93f1-64413aa0f1ca.mp3"
    },
    {
      "track": "QBO Match",
      "index": 2,
      "text": "We should match it instead of adding a new expense.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/c637d2ad-a7f0-4fe6-be14-44fdc88ee0a1.mp3"
    },
    {
      "track": "QBO Match",
      "index": 3,
      "text": "The bill payment should be linked to the original bill.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/7127dc01-fa60-427c-899d-ffffbaf63f7e.mp3"
    },
    {
      "track": "QBO Match",
      "index": 4,
      "text": "I am checking for duplicate entries.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0a8fcfdb-69b7-4a55-b868-e01b5638266c.mp3"
    },
    {
      "track": "QBO Match",
      "index": 5,
      "text": "Let's reconcile the account after the transactions are matched.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/0909e800-b449-426d-bf9e-a105f6f228ed.mp3"
    },
    {
      "track": "Approval",
      "index": 1,
      "text": "This payment requires approval before it can move forward.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/6f66e4b6-e424-422a-9f6a-d56012f42709.mp3"
    },
    {
      "track": "Approval",
      "index": 2,
      "text": "The approver needs enough context to make a decision.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/602e36df-5a97-4582-ba90-72aff67e0f92.mp3"
    },
    {
      "track": "Approval",
      "index": 3,
      "text": "The workflow should reflect how the team actually works.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/1506f399-41e6-45f0-9253-8054a6b45322.mp3"
    },
    {
      "track": "Approval",
      "index": 4,
      "text": "An approval step should not create unnecessary delays.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d31c4af9-718b-400c-92c8-03df26fdffd4.mp3"
    },
    {
      "track": "Approval",
      "index": 5,
      "text": "I want the controls to be clear without making the process heavier.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/dbc88fd1-ad22-4c26-adb9-243fea764087.mp3"
    },
    {
      "track": "Psalm 23 — By Still Waters",
      "index": 1,
      "text": "The Lord is my shepherd; I shall not want.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/1b50b2a4-71b6-43b4-ac81-d6501349d7c8.mp3"
    },
    {
      "track": "Psalm 23 — By Still Waters",
      "index": 2,
      "text": "He makes me lie down in green pastures.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/74e87780-fa24-4ca3-99f3-241e3d34aa2a.mp3"
    },
    {
      "track": "Psalm 23 — By Still Waters",
      "index": 3,
      "text": "He leads me beside still waters.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/7dd0e1d7-65ef-4615-896f-ea954c269f06.mp3"
    },
    {
      "track": "Psalm 23 — By Still Waters",
      "index": 4,
      "text": "He restores my soul.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/502ad6a8-81a4-44df-bd71-ba5706e30b18.mp3"
    },
    {
      "track": "Psalm 23 — By Still Waters",
      "index": 5,
      "text": "I do not have to carry everything by myself.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d166254a-f00e-4f09-9e2f-9b753dadfa09.mp3"
    },
    {
      "track": "Do My Part",
      "index": 1,
      "text": "I can do my part and leave the outcome to God.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/4890087b-ddce-4dd8-ad30-e69a1484b6f9.mp3"
    },
    {
      "track": "Do My Part",
      "index": 2,
      "text": "I do not need to solve everything today.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/f5657f5f-30f5-468d-a8bc-d98a178dc36c.mp3"
    },
    {
      "track": "Do My Part",
      "index": 3,
      "text": "Rest is not the same as giving up.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/67645331-460e-4287-a344-e4b7e50cbfe8.mp3"
    },
    {
      "track": "Do My Part",
      "index": 4,
      "text": "I can be responsible without controlling everything.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/3c2666d8-085d-4ba6-bfec-c282bead5039.mp3"
    },
    {
      "track": "Do My Part",
      "index": 5,
      "text": "What is mine to do today?",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/79435c4d-8e22-44bd-aeea-d377d67c89f7.mp3"
    },
    {
      "track": "Boundaries",
      "index": 1,
      "text": "I can be clear without being harsh.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/69df94b0-9e1a-4951-827a-b5ee7f7a7560.mp3"
    },
    {
      "track": "Boundaries",
      "index": 2,
      "text": "I do not have to answer immediately.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d17c9f5e-18fe-4a32-8a84-94d0c94d1215.mp3"
    },
    {
      "track": "Boundaries",
      "index": 3,
      "text": "I can listen without taking over the problem.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/5745a10a-c234-444c-870d-9f8bf4b54de4.mp3"
    },
    {
      "track": "Boundaries",
      "index": 4,
      "text": "Someone else's urgency does not automatically become my emergency.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/dfc9f2ec-26ea-4bfd-84e5-a2141d0280d8.mp3"
    },
    {
      "track": "Boundaries",
      "index": 5,
      "text": "A clear boundary can protect a healthy relationship.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/97fb4cf1-78f7-44f3-8eaf-885d3c5608ed.mp3"
    },
    {
      "track": "A Quiet Day",
      "index": 1,
      "text": "I am going for a walk by the lake.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/d34c6c8f-8abd-45d1-bfd7-4e3450777bff.mp3"
    },
    {
      "track": "A Quiet Day",
      "index": 2,
      "text": "I do not need to fill every quiet moment.",
      "url": "https://storage.googleapis.com/adm--audio-playback--7d--public/mcp-preview/b2d73853-161f-4478-b8c8-9df9163b5bd2.mp3"
    },
    {
